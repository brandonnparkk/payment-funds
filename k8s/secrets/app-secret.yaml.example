# Template for k8s/app-secret.yaml. Copy it, fill in real values, then encrypt
# in place before doing anything else with it:
#
#   cp k8s/app-secret.example.yaml k8s/app-secret.yaml
#   $EDITOR k8s/app-secret.yaml
#   sops -e -i k8s/app-secret.yaml
#   grep -q 'ENC\[' k8s/app-secret.yaml && echo encrypted
#
# Only the encrypted k8s/app-secret.yaml is committed. .sops.yaml in this
# directory encrypts the stringData block and leaves the keys readable.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
type: Opaque
stringData:
  # Username, password and database must match postgres-secret.yaml.
  # Host is the Service name; the Service is headless, so this resolves
  # straight to the pod IP.
  ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=REPLACE_ME;Username=REPLACE_ME;Password=REPLACE_ME"

  # Stripe test-mode keys. The webhook secret is the one for the endpoint you
  # register against the public URL, not the one `stripe listen` prints.
  Stripe__SecretKey: "sk_test_REPLACE_ME"
  Stripe__WebhookSecret: "whsec_REPLACE_ME"

  # Demo accounts, seeded on first start because SeedIdentity is true in the
  # Deployment. At least 8 characters with an uppercase letter, a lowercase
  # letter and a digit, or Identity refuses to create the user.
  SeedUsers__RequesterPassword: "REPLACE_ME"
  SeedUsers__ApproverPassword: "REPLACE_ME"
