@model IEnumerable<PaymentFunds.Models.Payee>

<h1>Payees</h1>
<a asp-action="Create" class="btn btn-primary mb-3">New Payee</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th><th>Email</th><th>Payout</th><th>Tax form</th><th>Status</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.DisplayName</td>
            <td>@p.Email</td>
            <td>@(p.PayoutDestinationMask ?? "-")</td>
            <td>@(p.TaxFormOnFile ? "Yes" : "No")</td>
            <td>@p.Status</td>
            <td>
                @if (p.Status == PaymentFunds.Models.PayeeStatus.Unverified
                     && User.IsInRole("Approver")
                     && p.CreatedBy != User.Identity!.Name)
                {
                    <form asp-action="Verify" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Verify</button>
                    </form>
                }
                @if (p.Status == PaymentFunds.Models.PayeeStatus.Verified && User.IsInRole("Approver"))
                {
                    <form asp-action="Suspend" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Suspend</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>