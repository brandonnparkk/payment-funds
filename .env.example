# Local docker compose configuration.
#
#   cp .env.example .env
#
# .env is gitignored. These values are used only by the local compose stack.
# They are unrelated to the Kubernetes deployment, which reads its credentials
# from sops-encrypted Secrets in k8s/.

# Postgres superuser password for the compose database.
# Any value will do. Generate one with:  openssl rand -base64 18
POSTGRES_PASSWORD=

# Demo accounts seeded on first start. Identity requires at least 8 characters
# with an uppercase letter, a lowercase letter, and a digit.
#   requester@paymentfunds.local
#   approver@paymentfunds.local
SEED_REQUESTER_PASSWORD=
SEED_APPROVER_PASSWORD=

# Optional. Leave blank to browse the app without Stripe; anything that calls
# the provider will fail until these are set to real test-mode values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
